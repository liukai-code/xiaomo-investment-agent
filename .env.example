# ========== MCP 服务 ==========
DASHSCOPE_MCP_URL=

# ========== 安全 ==========
CONFIG_ENCRYPTION_KEY=
ADMIN_PASSWORD=admin123

# ========== WebFetch 代理（可选） ==========
WEBFETCH_PROXY_HOST=
WEBFETCH_PROXY_PORT=0
